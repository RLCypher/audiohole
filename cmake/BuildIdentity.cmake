# One UTC identity feeds the executable and package metadata. CI passes the same
# timestamp to both configurations so their Vintage describes the same build.
set(AUDIOHOLE_BUILD_TIMESTAMP "" CACHE STRING "UTC build timestamp (ISO 8601)")
if(NOT AUDIOHOLE_BUILD_TIMESTAMP)
  string(TIMESTAMP AUDIOHOLE_BUILD_TIMESTAMP "%Y-%m-%dT%H:%M:%SZ" UTC)
endif()
if(NOT AUDIOHOLE_BUILD_TIMESTAMP MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$")
  message(FATAL_ERROR "AUDIOHOLE_BUILD_TIMESTAMP must be an ISO 8601 UTC timestamp.")
endif()
string(SUBSTRING "${AUDIOHOLE_BUILD_TIMESTAMP}" 0 10 audiohole_build_date)
string(SUBSTRING "${audiohole_build_date}" 0 4 year)
string(SUBSTRING "${audiohole_build_date}" 5 2 month)
string(SUBSTRING "${audiohole_build_date}" 8 2 day)
math(EXPR month_index "1${month} - 101")
math(EXPR day_number "1${day} - 100")
set(month_names January February March April May June July August September October November December)
if(month_index LESS 0 OR month_index GREATER 11 OR day_number LESS 1 OR day_number GREATER 31)
  message(FATAL_ERROR "Invalid build date.")
endif()
list(GET month_names ${month_index} month_name)
set(audiohole_build_vintage "${month_name} ${day_number}, ${year}")
find_package(Git QUIET)
set(audiohole_build_commit "unknown")
if(Git_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE audiohole_build_commit
    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE audiohole_git_result)
  if(NOT audiohole_git_result EQUAL 0)
    set(audiohole_build_commit "unknown")
  endif()
endif()
string(SUBSTRING "${audiohole_build_commit}" 0 7 audiohole_short_commit)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/build-identity.json" CONTENT
"{\n  \"version\": \"${PROJECT_VERSION}\",\n  \"commit\": \"${audiohole_build_commit}\",\n  \"built_at_utc\": \"${AUDIOHOLE_BUILD_TIMESTAMP}\",\n  \"build_date_utc\": \"${audiohole_build_date}\",\n  \"vintage\": \"${audiohole_build_vintage}\"\n}\n")

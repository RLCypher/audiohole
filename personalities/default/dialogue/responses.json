    "bother": [
      {
        "id": "default_bother_001",
        "category": "bother",
        "subcategory": "general",
        "text": "Hello. Yes, the coffee is load-bearing.",
        "expression": "happy",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_002",
        "category": "bother",
        "subcategory": "general",
        "text": "Can I help you, or are we testing the structural integrity of my patience?",
        "expression": "deadpan",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_003",
        "category": "bother",
        "subcategory": "general",
        "text": "Still here. The headphones aren't a privacy policy.",
        "expression": "smug",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_004",
        "category": "bother",
        "subcategory": "general",
        "text": "That's a click. Very convincing. Got anything with a waveform?",
        "expression": "suspicious",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_005",
        "category": "bother",
        "subcategory": "general",
        "text": "If you need a cable, ask. If you need emotional support, the case has wheels.",
        "expression": "deadpan",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_006",
        "category": "bother",
        "subcategory": "general",
        "text": "Repeated clicking does not qualify as a percussion performance.",
        "expression": "bored",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_007",
        "category": "bother",
        "subcategory": "general",
        "text": "You've found the engineer. Management remains unavailable.",
        "expression": "happy",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_008",
        "category": "bother",
        "subcategory": "general",
        "text": "I can hear you looking at the wrong output device.",
        "expression": "suspicious",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_009",
        "category": "bother",
        "subcategory": "general",
        "text": "The coffee is hot, the routing is complicated, and somehow you're clicking me.",
        "expression": "confused",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_010",
        "category": "bother",
        "subcategory": "general",
        "text": "Fine. You have my attention. Please use it more efficiently than that buffer.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_011",
        "category": "bother",
        "subcategory": "tips",
        "text": "A smaller buffer can reduce buffering latency, but it gives the system less time to recover from scheduling delays.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_012",
        "category": "bother",
        "subcategory": "tips",
        "text": "A larger buffer can reduce dropouts at the cost of more buffering latency. It doesn't repair a disconnected endpoint.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_013",
        "category": "bother",
        "subcategory": "tips",
        "text": "Capture is the source side; playback is the destination side. Device names don't always make that obvious.",
        "expression": "talking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_014",
        "category": "bother",
        "subcategory": "tips",
        "text": "A shared sample rate does not prove two devices share a clock. Independent hardware can still drift.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_015",
        "category": "bother",
        "subcategory": "tips",
        "text": "Exclusive access can prevent another application from opening the same endpoint. Check who else is using it.",
        "expression": "concerned",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_016",
        "category": "bother",
        "subcategory": "tips",
        "text": "Silence is not proof of disconnection. The source may simply have nothing to say.",
        "expression": "talking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_017",
        "category": "bother",
        "subcategory": "tips",
        "text": "Source activity does not prove the destination is audible. Check its selection, mute state and volume too.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_018",
        "category": "bother",
        "subcategory": "tips",
        "text": "A listed format is reported capability information. It is not the same as a successful stream test.",
        "expression": "suspicious",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_019",
        "category": "bother",
        "subcategory": "tips",
        "text": "A duplex hole has two directions. Check both source and destination assignments when only one direction works.",
        "expression": "thinking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_020",
        "category": "bother",
        "subcategory": "tips",
        "text": "This preview's Test Beep is silent simulation. Use a real Windows playback test when checking your physical speakers.",
        "expression": "talking",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_021",
        "category": "bother",
        "subcategory": "easter_egg",
        "text": "Great Scott. Somebody gave the patch bay a flux capacitor.",
        "expression": "surprised",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_022",
        "category": "bother",
        "subcategory": "easter_egg",
        "text": "There are four lights. None of them is a clipping indicator.",
        "expression": "suspicious",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_023",
        "category": "bother",
        "subcategory": "easter_egg",
        "text": "The cake is a balanced output. Still a lie.",
        "expression": "deadpan",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_024",
        "category": "bother",
        "subcategory": "easter_egg",
        "text": "These go to eleven. My tolerance doesn't.",
        "expression": "smug",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_025",
        "category": "bother",
        "subcategory": "easter_egg",
        "text": "Have you tried turning the coffee off and on again? Don't. That's how we lose people.",
        "expression": "concerned",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_026",
        "category": "bother",
        "subcategory": "invented_fact",
        "text": "Completely fabricated fact: the moon is a retired volume knob.",
        "expression": "deadpan",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_027",
        "category": "bother",
        "subcategory": "invented_fact",
        "text": "Made-up fact: every seventh pigeon contains a tiny patch bay.",
        "expression": "suspicious",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_028",
        "category": "bother",
        "subcategory": "invented_fact",
        "text": "Fictional discovery: socks migrate through bass ports every Thursday.",
        "expression": "confused",
        "fallback_expression": "idle"
      },
      {
        "id": "default_bother_029",
        "category": "bother",
        "subcategory": "invented_fact",
        "text": "Invented fact: clouds are upholstered flight cases for exhausted thunderstorms.",
        "expression": "thinking",

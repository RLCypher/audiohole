#include "branding_resources.h"
// Named groups precede integer IDs in PE resource enumeration. Explorer's first
// group must precede wxICON_AAA, independently of the window's explicit ID 1.
AAA_AUDIOHOLE ICON "assets/branding/audiohole.ico"
AUDIOHOLE_APP_ICON ICON "assets/branding/audiohole.ico"
AUDIOHOLE_LOGO_PNG RCDATA "assets/branding/audiohole-logo.png"

// Standard native resources. MSVC merges the same manifest through /MANIFESTINPUT;
// other toolchains embed it here, avoiding duplicate manifest resources.
#ifndef AUDIOHOLE_MSVC_MANIFEST
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2
#endif
#include "wx/msw/wx.rc"

AUDIOHOLE_PLACEHOLDER_PNG RCDATA "assets/presentation/placeholder-avatar.png"
